# =============================================================================
# Akilimo Data Tools — Python scripts environment configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Priority (highest to lowest):
#   1. CLI flags  (--zenodo-id, --sandbox, ...)
#   2. Shell environment variables  (export X=Y)
#   3. This .env file
#   4. Built-in fallback defaults
#
# .env is gitignored — never commit it.
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub repository — used only in Zenodo deposit metadata
# -----------------------------------------------------------------------------

GITHUB_OWNER=masgeek
GITHUB_REPO=akilimo-recommendations

# -----------------------------------------------------------------------------
# Zenodo — all data assets are hosted here
# -----------------------------------------------------------------------------

# Record ID of the published Zenodo deposit.
ZENODO_RECORD_ID=19231022

# Set to "1" to target sandbox.zenodo.org instead of zenodo.org.
# Use this for testing uploads without creating real public records.
ZENODO_USE_SANDBOX=0

# -----------------------------------------------------------------------------
# Zenodo upload credentials (maintainers only — sensitive)
# -----------------------------------------------------------------------------

# Personal access token for the Zenodo API.
# Generate at: https://zenodo.org → Account → Applications → Personal access tokens
# Required scope: deposit:write
# Never share or commit this value.
ZENODO_TOKEN=

# If you are updating an existing deposit draft, set its ID here so you don't
# have to pass --deposit-id every time.
ZENODO_DEPOSIT_ID=

# -----------------------------------------------------------------------------
# Zenodo deposit metadata (used when creating a new deposit)
# -----------------------------------------------------------------------------

ZENODO_TITLE=Akilimo Cassava Recommendations — Data Assets
ZENODO_AFFILIATION=IITA / International Institute of Tropical Agriculture
ZENODO_LICENSE=cc-by-4.0
