# =============================================================================
# Akilimo Data Tools — Python scripts environment configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Priority (highest to lowest):
#   1. CLI flags  (--zenodo-id, --sandbox, ...)
#   2. Shell environment variables  (export X=Y)
#   3. This .env file
#   4. Built-in fallback defaults
#
# .env is gitignored — never commit it.
#
# NOTE: CI keys its cache of the runtime data on a hash of THIS file
# (runtime-data-v2-<hash of scripts/.env.example> in .github/workflows/ci.yml).
# Any edit here, even a comment, makes the next CI run download the data again.
# =============================================================================

# -----------------------------------------------------------------------------
# Which assets to bundle, upload and download (config: scripts/assets.json)
# -----------------------------------------------------------------------------
# Everything in the data folder is bundled: each folder directly under data/ is
# one asset with its own archive (data/soil -> soil-data.tar.gz), found
# automatically. What is NOT bundled is the exclusion list in assets.json
# (hidden folders, *.sqlite, files tracked in git), which an extraction also
# never overwrites. An asset listed in "on_demand" (none now) is bundled and uploaded but
# setup-data fetches it only with --only NAME or ASSETS=NAME.
# To keep something out for good, add a pattern to "exclude" (whole folders, repo or
# server files) or "ignore" (junk inside the folders: *.tmp, *.bak, ...) in assets.json; for one run use
# `poetry run bundle-assets --ignore PATTERN` (repeatable; relative to data/, e.g.
# 'yield/*.bak', 'soil/old', '*.tmp'), or set ASSETS_IGNORE below for good.
#
# Every command takes --only NAME and --exclude NAME (repeatable); the two
# variables below set the same for good. `poetry run setup-data --list-assets`
# shows the names.
#
#   poetry run bundle-assets              bundle the selected assets (-i: choose one by one)
#                                         and write dist/manifest.json (archive, SHA-256 and
#                                         file list of every asset). Archives are reproducible:
#                                         unchanged data gives the same hash.
#   poetry run upload-osf / upload-zenodo upload the bundles and the manifest, skipping any
#                                         file whose hash the host already holds
#                                         (OSF: SHA-256, Zenodo: MD5) and, via
#                                         dist/upload-state.json, any file this machine
#                                         already uploaded (safe to re-run after a
#                                         failure); --force uploads all.
#   poetry run upload-github              the same, to a GitHub release (see GitHub Releases below)
#   poetry run setup-data                 reads the published manifest: checks each download's
#                                         SHA-256 and extracts only the files it lists
#                                         (--no-manifest ignores it).

# Handle exactly these assets (comma separated). Empty = every default asset.
ASSETS=

# Leave these out, e.g. a server that never serves PDC: ASSETS_EXCLUDE=dssat
ASSETS_EXCLUDE=

# Leave matching files out of every bundle (and never overwrite them on extraction).
# Comma separated, relative to data/: ASSETS_IGNORE=yield/*.bak,soil/old,*.tmp
ASSETS_IGNORE=

# -----------------------------------------------------------------------------
# Where the data comes from: github (the default), osf or zenodo
# -----------------------------------------------------------------------------
# setup-data --source. Empty = default_source in scripts/assets.json, which is github. CI
# and the servers use the DATA_SOURCE repository variable the same way: leave it unset for
# github, set it to osf or zenodo to go back.
DATA_SOURCE=

# -----------------------------------------------------------------------------
# GitHub Releases — data hosting as assets of a release of this repository
# -----------------------------------------------------------------------------
# upload-github publishes the bundles and manifest.json to one release (a pre-release
# that is never marked "latest"); setup-data --source github downloads them. Assets
# can be up to 2 GiB; GitHub reports a SHA-256 per asset, used to skip unchanged files.

# owner/name of the repository holding the release. Empty = github.repo in
# scripts/assets.json (IITA-AKILIMO/akilimo-data, private), else GITHUB_REPOSITORY.
GITHUB_DATA_REPO=

# The release tag. Empty = github.tag in scripts/assets.json (data-latest). Use a dated tag
# (data-2026-11-23) to keep a release of its own.
GITHUB_DATA_TAG=

# Token for the data repository. Create a fine-grained personal access token
# (GitHub > Settings > Developer settings > Personal access tokens > Fine-grained) with
# Repository access: Only select repositories > the data repository, and:
#   download (setup-data):  Contents: Read-only      (Metadata: Read-only is automatic)
#   upload (upload-github): Contents: Read and write (creates the release, uploads and
#                                                      replaces assets)
# Use two tokens: a read-only one for CI and the servers (the DATA_GITHUB_TOKEN secret)
# and a read-and-write one only on the machines that publish. A classic token needs the
# repo scope for either. Empty = the GitHub CLI's login (gh auth login). Sent to
# api.github.com and uploads.github.com only. Never share or commit this value.
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# GitHub repository — used only in Zenodo deposit metadata
# -----------------------------------------------------------------------------

GITHUB_OWNER=masgeek
GITHUB_REPO=akilimo-recommendations

# -----------------------------------------------------------------------------
# Zenodo — all data assets are hosted here
# -----------------------------------------------------------------------------

# Record ID of the published Zenodo deposit.
ZENODO_RECORD_ID=19231022

# Set to "1" to target sandbox.zenodo.org instead of zenodo.org.
# Use this for testing uploads without creating real public records.
ZENODO_USE_SANDBOX=0

# -----------------------------------------------------------------------------
# Zenodo upload credentials (maintainers only — sensitive)
# -----------------------------------------------------------------------------

# Personal access token for the Zenodo API.
# Generate at: https://zenodo.org → Account → Applications → Personal access tokens
# Required scope: deposit:write
# Never share or commit this value.
ZENODO_TOKEN=

# If you are updating an existing deposit draft, set its ID here so you don't
# have to pass --deposit-id every time.
ZENODO_DEPOSIT_ID=

# -----------------------------------------------------------------------------
# Zenodo deposit metadata (used when creating a new deposit)
# -----------------------------------------------------------------------------

ZENODO_TITLE=Akilimo Cassava Recommendations — Data Assets
ZENODO_AFFILIATION=IITA / International Institute of Tropical Agriculture
ZENODO_LICENSE=cc-by-4.0

# -----------------------------------------------------------------------------
# OSF (Open Science Framework) — alternative data hosting at osf.io
# -----------------------------------------------------------------------------

# Node ID of the OSF project (5-character code in the project URL).
# Example: for https://osf.io/abc12/ the node ID is "abc12".
# Used by: setup-data --source osf, upload-osf
OSF_NODE_ID=rcjv5

# Personal access token for the OSF API.
# Generate at: https://osf.io/settings/tokens
# Required scope: osf.full_write (for uploading); osf.full_read is enough for
# setup-data. OSF answers HTTP 401 to the file listing of a project without one,
# so set it for setup-data. For a private project the token must allow reading
# file contents too (the download is refused without it). It is sent to api.osf.io
# and files.osf.io only.
# Never share or commit this value. (CI and the server workflows use the
# OSF_TOKEN repository secret.)
OSF_TOKEN=
