# =============================================================================
# Akilimo Recommendation Engine — R API environment configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# For production (systemd), set these in the service's EnvironmentFile=
# directive instead of a .env file.
#
# .env is gitignored — never commit it.
# =============================================================================

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------

# Absolute path to the project root.
# Defaults to "." (current working directory) if not set.
AKILIMO_ROOT=.

# Plumber listen address and port.
# API_HOST defaults to 0.0.0.0 (all interfaces).
# API_PORT defaults to 8000.
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# Email notifications
#
# Select a provider with EMAIL_PROVIDER (default: smtp).
# EMAIL_FROM sets the sender address for all providers.
#
# Supported providers:
#   smtp      — any SMTP relay (uses mailR; requires Java)
#   mailtrap  — Mailtrap Sending API (no Java required)
#   mailgun   — Mailgun REST API    (no Java required)
# -----------------------------------------------------------------------------

EMAIL_PROVIDER=smtp
EMAIL_FROM=

# SMTP (EMAIL_PROVIDER=smtp)
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_PORT=587

# Mailtrap Sending API (EMAIL_PROVIDER=mailtrap)
# Obtain key at: https://mailtrap.io → Sending → API Tokens
MAILTRAP_API_KEY=

# Mailgun REST API (EMAIL_PROVIDER=mailgun)
# Obtain key at: https://app.mailgun.com → API Keys
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us

# -----------------------------------------------------------------------------
# Location map in PDF reports (optional)
#
# Resolution order:
#   1. MAPBOX_TOKEN set → Mapbox Static Images API (recommended)
#   2. MAP_API_URL set  → generic static-map service
#   3. Neither set      → offline coordinate card (lat/lon text, no network)
#
# Mapbox (recommended):
#   Get a free token at https://account.mapbox.com (50 000 req/month free).
#   Select "Public token" scope — no additional scopes required.
MAPBOX_TOKEN=

# Generic static-map service (alternative to Mapbox):
#   The service must accept:  GET {MAP_API_URL}?lat=…&lon=…&zoom=10&size=800x300
#   and return a PNG image.
MAP_API_URL=

# -----------------------------------------------------------------------------
# Price database (SQLite)
# -----------------------------------------------------------------------------

# Path to the SQLite price database.
# Relative paths are resolved from AKILIMO_ROOT.
# The file is created and seeded from CSV on first server start.
AKILIMO_DB_PATH=data/input/akilimo_compute.sqlite

# External price / translation API (optional — leave blank to disable auto-refresh).
# Must include the full versioned base path; do NOT add a trailing slash.
# Example: AKILIMO_API_URL=https://api.example.com/api/v1
# Endpoints called:
#   GET {AKILIMO_API_URL}/default-prices?country={CC}&page=1
#   GET {AKILIMO_API_URL}/starch-prices?country={CC}&page=1
#   GET {AKILIMO_API_URL}/translations?page=1
# Also used by:  Rscript refresh_prices.R
AKILIMO_API_URL=
AKILIMO_API_TOKEN=

# Days before fertilizer/cassava/labour prices trigger an auto-refresh.
# Default: 7
PRICE_MAX_AGE_DAYS=7
# A refresh fetches only changed prices; once a day (or on --full) it fetches every active price
# and removes the ones the price service no longer lists (deactivated). Hours between full fetches.
PRICE_FULL_SYNC_HOURS=24

# Days before starch factory prices trigger an auto-refresh.
# Default: 30
STARCH_PRICE_MAX_AGE_DAYS=30

# Days before translation strings trigger an auto-refresh.
# Default: 30
TRANSLATIONS_MAX_AGE_DAYS=30

# -----------------------------------------------------------------------------
# Logging (all optional)
# -----------------------------------------------------------------------------
# Logging works like Laravel's: a log line goes to a stack of channels, and each channel has its own level and format.
# Channels: file (the daily file in LOG_DIR), stderr (the console, or the systemd journal), stdout, null (nothing).
# "stack" (the default) uses the channels listed in LOG_STACK; any other value is that one channel on its own.
# LOG_CHANNEL=stack
# LOG_STACK=file,stderr
# The level every channel uses unless it has its own: TRACE, DEBUG, INFO, SUCCESS, WARN or ERROR. Default: INFO
#   TRACE adds the request (the farmer's name, email, phone and plot name are always replaced by <redacted>) and the
#   whole result; DEBUG a short summary of the result. Every request ends with one INFO line (REQUEST DONE) with its
#   status, type, country and duration. Every line of a request carries its id: the requestId the AKILIMO API sends,
#   or a short one made here.
# LOG_LEVEL=INFO
# A channel's own level: here everything goes to the file, but only INFO and above to the console.
# (The older LOG_STDERR=false, or 0, no, off, still means LOG_STDERR_LEVEL=INFO.)
# LOG_FILE_LEVEL=DEBUG
# LOG_STDERR_LEVEL=INFO
# LOG_STDOUT_LEVEL=INFO
# text (one readable line per entry) or json (one JSON object per line, for a log collector). A channel can have its
# own, e.g. LOG_FILE_FORMAT=json with readable text on the console. Default: text
# LOG_FORMAT=text
# LOG_FILE_FORMAT=json
# LOG_STDERR_FORMAT=text
# LOG_STDOUT_FORMAT=json
# A single log line longer than this many characters is cut; 0 = no limit. Default: 20000
# LOG_MAX_CHARS=20000
# Delete daily log files older than this many days (checked once a day); 0 = keep them all. Default: 0
# LOG_KEEP_DAYS=0
# A request slower than this many milliseconds is logged as a WARN; 0 = never. Default: 30000
# LOG_SLOW_MS=30000
# Where the daily files (compute-YYYYMMDD.log) go, and their name prefix. Default: ./logs and compute
# LOG_DIR=./logs
# LOG_FILE_PREFIX=compute