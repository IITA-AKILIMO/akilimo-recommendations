[Unit]
Description=AKILIMO R Recommendation Engine
Documentation=https://github.com/IITA-AKILIMO/akilimo-recommendations
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/akilimo/projects/new_akilimo
ExecStart=/usr/bin/Rscript /home/akilimo/projects/new_akilimo/R/api2.R
ExecReload=/bin/kill -HUP $MAINPID

# Restart configuration
Restart=on-failure
RestartSec=5s
StartLimitInterval=300s
StartLimitBurst=5

# User and security
User=akilimo
Group=akilimo
UMask=0027

# Environment
Environment=PATH=/usr/bin:/usr/local/bin
Environment=R_LIBS_USER=/home/akilimo/R/library

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=akilimo-api

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/akilimo/projects/new_akilimo/logs /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=200%

# Process management
TimeoutStartSec=60s
TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
