# Style-only linters are off until a formatting pass: they flag thousands of
# existing lines and would drown the checks that catch real mistakes. Turn them
# back on one at a time as files are tidied.
linters: linters_with_defaults(
    assignment_linter = NULL,
    brace_linter = NULL,
    commas_linter = NULL,
    commented_code_linter = NULL,
    indentation_linter = NULL,
    infix_spaces_linter = NULL,
    line_length_linter = NULL,
    object_name_linter = NULL,
    object_usage_linter = NULL,
    quotes_linter = NULL,
    return_linter = NULL,
    semicolon_linter = NULL,
    spaces_inside_linter = NULL,
    trailing_whitespace_linter = NULL,
    whitespace_linter = NULL
  )
exclusions: list(
    "old",
    "R/preprocess"
  )
